# WordPress runtime configuration and site data stay on the hosting account.
/wp-config.php
/wp-config-*.php
!/wp-config-sample.php
.env
.env.*
/wp-content/uploads/
/wp-content/uploads-bkp/

# Generated data, backups, and retired copies are not active website code.
/wp-content/litespeed/
/wp-content/updraft/
/wp-content/upgrade/
/wp-content/plugins-old/
/wp-content/themes-old/
/tools/
/*.sql
/*.sql.*
/*.log
/*.bak
/*.backup
/*.zip
/*.wpress
/*.pem
/*.key
/*.p12
/*.pfx
node_modules/
.DS_Store
Thumbs.db
.idea/
.vscode/
